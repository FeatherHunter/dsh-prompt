node_modules/
lib/client.js.map
*.tgz
*.tsbuildinfo
.DS_Store
# . 开头的目录一律忽略，避免干扰（.git/ 不受此影响，.gitignore/.gitattributes 是文件不受 */ 规则影响）
.*/
# 例外：.github/ 必须入库 —— Star History 每日更新的 Actions 工作流住在这里
!.github/
!.github/**
# 例外：.out-of-scope/ 必须入库 —— triage 的 wontfix 决策记录要能从票里链接
!.out-of-scope/
!.out-of-scope/**
.wayfinder/
.tmp-*
.tmp-*/
scripts/.rt-tmp/
.tmp-rt2/
