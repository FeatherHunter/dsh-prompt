{
  "name": "dsh-prompt",
  "version": "0.1.8",
  "description": "DSH prompt 工具箱：预制 + 自定义 prompt 模板，点击即插入当前对话输入框（v1 常规模式 + v1.1 智能模式悬浮卡） | Prompt toolbox for DeepSeek Harness: preset + custom prompt templates, one-click insert into the conversation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "prompt",
    "prompts",
    "templates",
    "prompt-templates",
    "preset-prompts",
    "ai",
    "llm",
    "toolbox"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "event-list.dsh-prompt.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "tsdown",
    "build:update-host": "node scripts/update/build-host.mjs",
    "derive:update-values": "node node_modules/dsh-plugin-update/derive-client-values.mjs --prefix prompt --out src/update/gen/updateClient.derived.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:host",
    "typecheck:host": "tsc -p tsconfig.host.json",
    "test:modal": "node scripts/test-modal-remount.cjs",
    "test:issue-14": "node scripts/test-issue-14.cjs",
    "test:issue-20": "node scripts/test-issue-20.cjs",
    "test:issue-20-host": "node scripts/test-issue-20-host.cjs",
    "test:issue-21": "node scripts/test-issue-21.cjs",
    "test:bottom-up": "node scripts/test-bottom-up.cjs",
    "test:issue-23": "node scripts/test-issue-23.cjs",
    "test:issue-34": "node scripts/test-issue-34.cjs",
    "test:issue-35": "node scripts/test-issue-35.cjs",
    "test:issue-37": "node scripts/test-issue-37.cjs",
    "test:issue-31": "node scripts/test-issue-31.cjs",
    "test:issue-32": "node scripts/test-issue-32.cjs",
    "test:smart-draft": "node scripts/test-smart-draft.cjs",
    "test:host-deps": "node scripts/test-host-deps.cjs",
    "test:log": "node scripts/test-log.cjs",
    "test:issue-39": "node scripts/test-issue-39.cjs",
    "test:issue-40": "node scripts/test-issue-40.cjs",
    "test:issue-41": "node scripts/test-issue-41.cjs",
    "test:issue-42": "node scripts/test-issue-42.cjs",
    "test:issue-61": "node scripts/test-issue-61.cjs",
    "test:issue-66": "node scripts/test-issue-66.cjs",
    "test": "npm run test:modal && npm run test:issue-14"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "dsh-plugin-update": "0.1.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.2",
    "dsh-log": "^0.2.1",
    "zod": "^4.5.4"
  }
}
